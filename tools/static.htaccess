# BEGIN Dao statico
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteCond %{HTTP_HOST} ^dao-arts\.it$ [NC]
RewriteRule ^(.*)$ https://www.dao-arts.it/$1 [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^static(/|$) - [F]
RewriteRule ^static/ - [L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !/\.
RewriteCond %{DOCUMENT_ROOT}/static/$1 -f
RewriteRule ^(.*[^/])$ static/$1 [L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{HTTP_COOKIE} !(wordpress_logged_in_|origine=1)
RewriteCond $1 ^search/$ [OR]
RewriteCond %{QUERY_STRING} !(^|&)(s|p|page_id|preview|attachment_id)=
RewriteCond %{DOCUMENT_ROOT}/static/$1index.html -f
RewriteRule ^(.*/)?$ static/$1index.html [L]
</IfModule>
AddType image/webp .webp
AddType font/woff2 .woff2
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "[0-9a-f]{10}\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(webp|woff2)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
# END Dao statico
